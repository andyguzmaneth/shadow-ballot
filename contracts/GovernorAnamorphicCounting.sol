pragma solidity ^0.8.24;

import {Governor} from "@openzeppelin/contracts/governance/Governor.sol";
import {IGovernor} from "@openzeppelin/contracts/governance/IGovernor.sol";

/**
 * @dev Interface matching the Groth16Verifier generated by `snarkjs zkey export
 *      solidityverifier` from the real compiled+proven eligibility.circom
 *      (contracts/EligibilityVerifier.sol) — public signals are [root,
 *      nullifier, proposalId], in that order, matching the circuit's
 *      `component main {public [proposalId]}` output ordering.
 */
interface IEligibilityVerifier {
    function verifyProof(
        uint256[2] calldata pA,
        uint256[2][2] calldata pB,
        uint256[2] calldata pC,
        uint256[3] calldata pubSignals
    ) external view returns (bool);
}

/**
 * @title GovernorAnamorphicCounting
 * @notice The dissertation's target integration ("integrating with OpenZeppelin
 *         Governor, the most widely deployed DAO voting framework") — a real
 *         counting extension, not a standalone contract next to Governor.
 *
 * The architectural mismatch this resolves: standard Governor.castVote() always
 * uses msg.sender as the voter and looks up their weight via getVotes(). This
 * protocol's whole point is that votes do NOT come from the voter's known
 * address — they arrive as disguised transfers to stealth addresses, decoded
 * off-chain by the coordinator. There is no way to make msg.sender-based voting
 * work here without breaking participation non-observability, so this extension
 * does not try to preserve castVote() as the voting entry point. Instead:
 *
 *   - Individual castVote()/castVoteWithReason()/etc. are all disabled
 *     (_countVote always reverts) — nobody should be able to cast a Governor
 *     vote the normal way in this scheme, and a revert makes that explicit
 *     rather than silently accepting and misrecording votes.
 *   - The coordinator submits ONE aggregated tally per proposal, after decoding
 *     all anamorphic votes off-chain (vote.ts's decodeVote, scaled up).
 *   - Double-voting is prevented by ZK nullifiers (circuits/eligibility.circom's
 *     Poseidon(secret, proposalId) output), checked for on-chain uniqueness at
 *     submission time — not by Governor's usual per-account hasVoted mapping,
 *     which doesn't apply when votes aren't attributed to on-chain accounts.
 *
 * A real correctness issue this design creates, and the fix, stated explicitly:
 * Governor.state() transitions Active -> Defeated/Succeeded purely based on
 * whether the voting deadline has passed, using _quorumReached/_voteSucceeded.
 * Before the coordinator submits, those both read zero votes, so a naive
 * implementation would show every proposal as Defeated the instant the voting
 * window closes, even though the real votes just haven't been tallied on-chain
 * yet. Fixed by overriding state() (see below) to hold at Active past the
 * deadline until the tally is actually submitted.
 */
abstract contract GovernorAnamorphicCounting is Governor {
    struct ProposalTally {
        uint256 againstVotes;
        uint256 forVotes;
        uint256 abstainVotes;
        bool tallySubmitted;
    }

    mapping(uint256 proposalId => ProposalTally) private _proposalTallies;
    // Which proposal a nullifier was ZK-registered for — not just a flat used-set,
    // so submitAnamorphicTally can check a nullifier was registered for THIS
    // proposal specifically, not merely registered somewhere.
    mapping(bytes32 => uint256) private _nullifierRegisteredForProposal;
    mapping(bytes32 => bool) private _nullifierUsed;
    mapping(uint256 proposalId => bytes32) private _eligibilityRoot;

    address public immutable coordinator;
    IEligibilityVerifier public immutable eligibilityVerifier;

    /**
     * @dev BN254 (alt_bn128) scalar field prime — the modulus circom/snarkjs
     *      circuit signals live in. Found 2026-08-19 while wiring this up, not
     *      designed in from the start: Governor's proposalId is a full 256-bit
     *      keccak256 output (Governor.hashProposal), but roughly 3/4 of all
     *      possible 256-bit values exceed this ~2^254 prime and cannot be a
     *      circuit input as-is. Both sides of the integration (this contract,
     *      and whatever generates the off-chain witness/proof) MUST reduce
     *      Governor's proposalId mod this prime before it's used as the
     *      circuit's public `proposalId` signal — otherwise a proof generated
     *      for the reduced value will never match a comparison against the
     *      raw, unreduced Governor ID. Collision risk from the reduction
     *      (two different Governor proposals reducing to the same field
     *      element) is negligible for any realistic number of concurrent
     *      proposals — birthday-bound over a ~2^254 space — but is a real,
     *      nonzero property worth stating rather than ignoring.
     */
    uint256 private constant BN254_SCALAR_FIELD =
        21888242871839275222246405745257275088548364400416034343698204186575808495617;

    event AnamorphicTallySubmitted(
        uint256 indexed proposalId,
        uint256 forVotes,
        uint256 againstVotes,
        uint256 abstainVotes,
        uint256 nullifierCount
    );
    event EligibilityRootSet(uint256 indexed proposalId, bytes32 root);
    event NullifierRegistered(uint256 indexed proposalId, bytes32 nullifier);

    error NotCoordinator(address caller);
    error TallyAlreadySubmitted(uint256 proposalId);
    error VotingNotYetClosed(uint256 proposalId);
    error NullifierAlreadyUsed(bytes32 nullifier);
    error DirectVotingDisabled();
    error InvalidEligibilityProof();
    error EligibilityRootAlreadySet(uint256 proposalId);
    error EligibilityRootNotSet(uint256 proposalId);
    error ProposalIdMismatch(uint256 expected, uint256 got);
    error NullifierNotRegisteredForProposal(bytes32 nullifier, uint256 proposalId);

    constructor(address _coordinator, IEligibilityVerifier _eligibilityVerifier) {
        coordinator = _coordinator;
        eligibilityVerifier = _eligibilityVerifier;
    }

    modifier onlyCoordinator() {
        if (msg.sender != coordinator) revert NotCoordinator(msg.sender);
        _;
    }

    /// @inheritdoc IGovernor
    // solhint-disable-next-line func-name-mixedcase
    function COUNTING_MODE() public pure virtual override returns (string memory) {
        return "support=bravo&quorum=for,abstain&params=anamorphic-coordinator-tally";
    }

    /**
     * @inheritdoc IGovernor
     * @dev Per-account hasVoted has no meaning here — no vote is ever attributed
     *      to an on-chain account. Always false; nullifiers (not this) prevent
     *      double-voting.
     */
    function hasVoted(uint256, address) public pure override returns (bool) {
        return false;
    }

    function proposalVotes(
        uint256 proposalId
    ) public view virtual returns (uint256 againstVotes, uint256 forVotes, uint256 abstainVotes) {
        ProposalTally storage t = _proposalTallies[proposalId];
        return (t.againstVotes, t.forVotes, t.abstainVotes);
    }

    function nullifierUsed(bytes32 nullifier) public view returns (bool) {
        return _nullifierUsed[nullifier];
    }

    /**
     * @notice Coordinator publishes the eligibility Merkle root (VoterRegistry
     *         commitments as of proposal creation, Ch3 §3.4.2a) that ZK proofs
     *         for this proposal must be checked against. Set once, before any
     *         nullifier can be registered for this proposal.
     */
    function setEligibilityRoot(uint256 proposalId, bytes32 root) external onlyCoordinator {
        if (_eligibilityRoot[proposalId] != bytes32(0)) revert EligibilityRootAlreadySet(proposalId);
        _eligibilityRoot[proposalId] = root;
        emit EligibilityRootSet(proposalId, root);
    }

    function eligibilityRoot(uint256 proposalId) public view returns (bytes32) {
        return _eligibilityRoot[proposalId];
    }

    /**
     * @notice Verifies a real Groth16 proof from circuits/eligibility.circom
     *         on-chain and, if valid, marks its nullifier registered for this
     *         proposal. This is what upgrades eligibility soundness (Property 3,
     *         Ch3 §3.3) from "the coordinator asserts eligibility" to
     *         "cryptographically checked on-chain" — anyone can call this
     *         (matching the circuit's own zero-knowledge guarantee: a valid
     *         proof reveals nothing about which registered voter produced it),
     *         not gated to the coordinator.
     *
     * @dev Deliberately does NOT verify or constrain vote choice — the circuit
     *      only proves eligibility + prevents double-voting via the nullifier.
     *      Vote choice (for/against/abstain) is still asserted by the
     *      coordinator in submitAnamorphicTally below, off-chain-decoded via
     *      the anamorphic-nonce layer, and is NOT bound to any individual
     *      nullifier here. This means a coordinator presenting N valid,
     *      distinct nullifiers has proven "N genuinely eligible, non-repeating
     *      votes exist" but has NOT had its claimed for/against/abstain
     *      breakdown of those N votes checked by anything. That gap is
     *      Property 4 (tally correctness, Ch3) — this function narrows the
     *      trust surface, it does not close it. Do not claim otherwise.
     */
    function registerEligibleNullifier(
        uint256 proposalId,
        uint256[2] calldata pA,
        uint256[2][2] calldata pB,
        uint256[2] calldata pC,
        uint256[3] calldata pubSignals // [root, nullifier, proposalId]
    ) external {
        bytes32 expectedRoot = _eligibilityRoot[proposalId];
        if (expectedRoot == bytes32(0)) revert EligibilityRootNotSet(proposalId);
        if (pubSignals[0] != uint256(expectedRoot)) revert InvalidEligibilityProof();
        // Reduce mod the circuit's field before comparing — see BN254_SCALAR_FIELD
        // doc comment. The off-chain proof MUST have been generated with the same
        // reduced value as its circuit input, or this never matches.
        if (pubSignals[2] != (proposalId % BN254_SCALAR_FIELD)) {
            revert ProposalIdMismatch(proposalId % BN254_SCALAR_FIELD, pubSignals[2]);
        }

        bytes32 nullifier = bytes32(pubSignals[1]);
        if (_nullifierUsed[nullifier]) revert NullifierAlreadyUsed(nullifier);

        if (!eligibilityVerifier.verifyProof(pA, pB, pC, pubSignals)) revert InvalidEligibilityProof();

        _nullifierUsed[nullifier] = true;
        _nullifierRegisteredForProposal[nullifier] = proposalId;
        emit NullifierRegistered(proposalId, nullifier);
    }

    /**
     * @notice Coordinator submits the aggregated, off-chain-decoded vote-choice
     *         breakdown for a proposal exactly once, after the voting deadline
     *         has passed. Every nullifier cited must already have been
     *         registered via registerEligibleNullifier for THIS proposal —
     *         this function no longer trusts nullifiers blindly (2026-08-19
     *         change; the original version accepted arbitrary bytes32 values
     *         from the coordinator with no ZK check at all).
     */
    function submitAnamorphicTally(
        uint256 proposalId,
        uint256 forVotes,
        uint256 againstVotes,
        uint256 abstainVotes,
        bytes32[] calldata nullifiers
    ) external onlyCoordinator {
        if (proposalDeadline(proposalId) >= clock()) revert VotingNotYetClosed(proposalId);

        ProposalTally storage t = _proposalTallies[proposalId];
        if (t.tallySubmitted) revert TallyAlreadySubmitted(proposalId);

        for (uint256 i = 0; i < nullifiers.length; i++) {
            if (_nullifierRegisteredForProposal[nullifiers[i]] != proposalId) {
                revert NullifierNotRegisteredForProposal(nullifiers[i], proposalId);
            }
        }

        t.forVotes = forVotes;
        t.againstVotes = againstVotes;
        t.abstainVotes = abstainVotes;
        t.tallySubmitted = true;

        emit AnamorphicTallySubmitted(proposalId, forVotes, againstVotes, abstainVotes, nullifiers.length);
        _tallyUpdated(proposalId);
    }

    /// @inheritdoc Governor
    function _quorumReached(uint256 proposalId) internal view virtual override returns (bool) {
        ProposalTally storage t = _proposalTallies[proposalId];
        return quorum(proposalSnapshot(proposalId)) <= t.forVotes + t.abstainVotes;
    }

    /// @inheritdoc Governor
    function _voteSucceeded(uint256 proposalId) internal view virtual override returns (bool) {
        ProposalTally storage t = _proposalTallies[proposalId];
        return t.forVotes > t.againstVotes;
    }

    /**
     * @inheritdoc Governor
     * @dev Always reverts — see contract-level doc comment. This is deliberate,
     *      not a stub: nobody should be able to cast a Governor vote the normal way.
     */
    function _countVote(
        uint256,
        address,
        uint8,
        uint256,
        bytes memory
    ) internal pure override returns (uint256) {
        revert DirectVotingDisabled();
    }

    /**
     * @inheritdoc Governor
     * @notice Overridden to hold a proposal at Active past its voting deadline
     *         until the coordinator submits the tally — otherwise base Governor
     *         would report every proposal Defeated the instant voting closes,
     *         since _quorumReached/_voteSucceeded both read zero votes pre-submission.
     */
    function state(uint256 proposalId) public view virtual override returns (ProposalState) {
        ProposalState baseState = super.state(proposalId);
        if (baseState == ProposalState.Defeated && !_proposalTallies[proposalId].tallySubmitted) {
            return ProposalState.Active;
        }
        return baseState;
    }
}
